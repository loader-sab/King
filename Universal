-- Helper Function untuk membuat Dropdown & Tombol Eksekusi
local function CreateScriptDropdown(tab, sectionTitle, scriptMap, dropdownTitle)
    tab:AddSection(sectionTitle)
    
    local nameList = {}
    for name, _ in pairs(scriptMap) do
        table.insert(nameList, name)
    end
    table.sort(nameList)
    
    local selectedScript = nameList[1]
    
    local dropdown = tab:AddDropdown(dropdownTitle .. "_Dropdown", {
        Title = dropdownTitle,
        Values = nameList,
        Multi = false,
        Default = 1,
    })
    
    dropdown:OnChanged(function(Value)
        selectedScript = Value
    end)
    
    tab:AddButton({
        Title = "Execute Selected Script",
        Description = "Jalankan script yang dipilih pada dropdown di atas",
        Callback = function()
            if scriptMap[selectedScript] then
                Fluent:Notify({
                    Title = "SAB KING Loader",
                    Content = "Executing: " .. selectedScript,
                    Duration = 3
                })
                task.spawn(function()
                    loadstring(game:HttpGet(scriptMap[selectedScript]))()
                end)
            end
        end
    })
end

